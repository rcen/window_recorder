exercises = #ff6b6b
eat_the_frog = #4d96ff

[FOCUS_SLOTS]                                                                                             
morning_focus = 09:00-12:30                                                                               
afternoon_focus = 13:25-16:45                                                                             

[VIBE_REPOS]
# Repositories considered "vibe coding" (personal/fun projects)
# These will be tracked separately from work coding
# Format: repo_name or folder_name (case-insensitive, partial match)
repos = window_recorder, tennis_game_log, personal_projects
# Paths that indicate vibe coding (optional, comma-separated)
paths = c:\projects\window_recorder, C:\projects\tennis_game_log

[SETTINGS]                                                                                                
timezone = America/New_York                                                                               
day_boundary_hour = 3                                                                                     
image_folder = figs/pictures                                                                              
md_folder = ../crlog_laptop                                                                               
recent_activity_minutes = 10
productivity_streak_threshold = 25
max_idle_break_minutes = 5
target_waste_ratio = 0.18                                                                              
                                                                                                          
[CATEGORIES]
# Vibe coding repos - MUST be before generic coding patterns to match first
window_recorder: vibe_coding
tennis_game_log: vibe_coding
personal_projects: vibe_coding
